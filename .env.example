# Copy this file to ".env" locally (and set the same variables in your host's
# dashboard, e.g. Render's Environment tab, when you deploy).

# --- Database ---
# Free Postgres connection string from Neon (neon.tech) or Supabase (supabase.com).
# Leave blank to use a local SQLite file for development.
DATABASE_URL=

# --- Security (all required in production) ---
# Random secret used to sign login sessions. Generate one with:
#   python -c "import os; print(os.urandom(32).hex())"
JWT_SECRET=

# Key used to encrypt sensitive text fields at rest. Generate one with:
#   python -c "from app.crypto_fields import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# Password for the seeded "admin" account on first run only (change the default!).
# After first run, change the password from inside the app instead.
ADMIN_INITIAL_PASSWORD=PEB77777@mmvm

# Comma-separated list of allowed frontend origins in production, e.g.
# https://your-app.onrender.com — leave blank/"*" for local dev.
ALLOWED_ORIGINS=*

# --- AI Assistant ---
# "gemini" (free tier) or "anthropic". Default: gemini.
AI_PROVIDER=gemini

# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional, only used if AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Telegram bot (optional, run as a separate process — see extras/telegram_bot.py) ---
# Free token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Base URL of your deployed backend, e.g. https://your-app.onrender.com
BACKEND_URL=http://127.0.0.1:8000
